    { "source": "/bills(/?)", "destination": "/frontend/pages/bills/index.html" },
    { "source": "/requests(/?)", "destination": "/frontend/pages/requests/index.html" },
    { "source": "/owners(/?)", "destination": "/frontend/pages/owners/index.html" },
    { "source": "/exports(/?)", "destination": "/frontend/pages/exports/index.html" },

    { "source": "/users/dashboard(/?)", "destination": "/frontend/users/dashboard/index.html" },
